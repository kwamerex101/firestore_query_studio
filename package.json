{
  "name": "firestore-query-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first desktop tool to find Firestore documents via natural language. Phase 1 MVP: read-only.",
  "homepage": "https://github.com/kwamerex101/firestore_query_studio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kwamerex101/firestore_query_studio.git"
  },
  "bugs": {
    "url": "https://github.com/kwamerex101/firestore_query_studio/issues"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.config.web.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "preview:web": "vite preview --config vite.config.web.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only firestore \"vitest run --config vitest.emulator.config.ts\"",
    "test:emulator-rtdb": "firebase emulators:exec --only database \"vitest run --config vitest.emulator.config.ts tests/integration/rtdbDriver.emulator.test.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/react-virtual": "^3.13.2",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.1.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "idb": "^8.0.3",
    "keytar": "^7.9.0",
    "lucide-react": "^0.469.0",
    "mssql": "^12.3.1",
    "mysql2": "^3.22.2",
    "papaparse": "^5.5.3",
    "pg": "^8.13.1",
    "pg-query-stream": "^4.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.0",
    "electron-vite": "^3.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.1.8",
    "workbox-window": "^7.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "keytar",
      "esbuild",
      "protobufjs",
      "@firebase/util",
      "pg",
      "better-sqlite3"
    ]
  }
}
